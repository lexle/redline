# Copy to .env.local and fill in. .env.local is gitignored; never commit a real key.

# OpenRouter key, used only on the server.
OPENROUTER_API_KEY=

# Every request pins the provider to Fireworks with no fallbacks (see the build brief),
# so this must be a model Fireworks serves on OpenRouter.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Supabase project. Leave empty to run without accounts (library and red lines are disabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
