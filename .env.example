# Copy to .env.local and fill in. .env.local is gitignored; never commit a real key.

# OpenRouter key, used only on the server.
OPENROUTER_API_KEY=

# Any OpenRouter model id. The default, per CLAUDE.md:
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Supabase project. Leave empty to run without accounts (library and red lines are disabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
